{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zackproser/ctx-contracts/schemas/ctx.work-outcome-draft.v1.json",
  "title": "ctx.work-outcome-draft.v1",
  "type": "object",
  "properties": {
    "contract": {
      "type": "string",
      "const": "ctx.work-outcome-draft.v1"
    },
    "registry_version": {
      "type": "string",
      "minLength": 1
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "description": {
          "type": "string",
          "maxLength": 8192
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "description": {
                "type": "string",
                "maxLength": 8192
              },
              "kind": {
                "type": "string",
                "enum": [
                  "input_set",
                  "action",
                  "artifact_requirement",
                  "verification_gate"
                ]
              },
              "policy": {
                "type": "string",
                "enum": [
                  "required",
                  "optional",
                  "waived"
                ]
              },
              "cardinality": {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "enum": [
                      "exact",
                      "at_least",
                      "dynamic"
                    ]
                  },
                  "target": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "mode",
                  "target"
                ],
                "additionalProperties": true
              },
              "predicate": {
                "type": "object",
                "additionalProperties": {}
              },
              "evaluator": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "evaluator_version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "required": [
              "key",
              "title",
              "description",
              "kind",
              "policy",
              "cardinality",
              "predicate",
              "evaluator",
              "evaluator_version"
            ],
            "additionalProperties": true
          },
          "minItems": 1
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "const": "depends_on"
              }
            },
            "required": [
              "from",
              "to",
              "kind"
            ],
            "additionalProperties": true
          }
        },
        "initial_memberships": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "input_node_key": {
                "type": "string",
                "minLength": 1
              },
              "resource_item_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "required": [
              "input_node_key",
              "resource_item_ids"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [
        "title",
        "description",
        "entities",
        "nodes",
        "edges",
        "initial_memberships"
      ],
      "additionalProperties": true
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "node_key": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string",
            "minLength": 1
          },
          "verifier_id": {
            "type": "string",
            "minLength": 1
          },
          "verifier_version": {
            "type": "string",
            "minLength": 1
          },
          "verifier_label": {
            "type": "string",
            "minLength": 1
          },
          "repository": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "key",
          "node_key",
          "title",
          "detail",
          "verifier_id",
          "verifier_version",
          "verifier_label"
        ],
        "additionalProperties": true
      },
      "minItems": 1
    },
    "extra_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "selected": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "version",
          "label",
          "selected"
        ],
        "additionalProperties": true
      }
    },
    "obligations": {
      "type": "object",
      "properties": {
        "repositories": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$"
          }
        },
        "join_requested": {
          "type": "boolean"
        },
        "parallel_requested": {
          "type": "boolean"
        }
      },
      "required": [
        "repositories",
        "join_requested",
        "parallel_requested"
      ],
      "additionalProperties": true
    },
    "graph_lint": {
      "type": "object",
      "properties": {
        "contract": {
          "type": "string",
          "const": "ctx.work-graph-lint.v1"
        },
        "valid": {
          "type": "boolean"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "severity": {
                "type": "string",
                "enum": [
                  "error",
                  "warning"
                ]
              },
              "code": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    }
                  ]
                }
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "severity",
              "code",
              "path",
              "message"
            ],
            "additionalProperties": true
          }
        },
        "topology": {
          "type": "object",
          "properties": {
            "entry_node_keys": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "terminal_node_keys": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "execution_order": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "entry_node_keys",
            "terminal_node_keys",
            "execution_order"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "contract",
        "valid",
        "diagnostics",
        "topology"
      ],
      "additionalProperties": true
    },
    "launch_ready": {
      "type": "boolean"
    },
    "generated_by": {
      "type": "string",
      "enum": [
        "model",
        "deterministic"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "contract",
    "registry_version",
    "prompt",
    "outcome",
    "steps",
    "extra_receipts",
    "graph_lint",
    "launch_ready",
    "generated_by",
    "generated_at"
  ],
  "additionalProperties": true
}
