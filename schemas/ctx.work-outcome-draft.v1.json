{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zackproser/ctx-contracts/schemas/ctx.work-outcome-draft.v1.json",
  "title": "ctx.work-outcome-draft.v1",
  "type": "object",
  "properties": {
    "contract": {
      "type": "string",
      "const": "ctx.work-outcome-draft.v1"
    },
    "schema_version": {
      "type": "number",
      "const": 2
    },
    "registry_version": {
      "type": "string",
      "minLength": 1
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "description": {
          "type": "string",
          "maxLength": 8192
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "description": {
                "type": "string",
                "maxLength": 8192
              },
              "kind": {
                "type": "string",
                "enum": [
                  "input_set",
                  "action",
                  "artifact_requirement",
                  "verification_gate"
                ]
              },
              "policy": {
                "type": "string",
                "enum": [
                  "required",
                  "optional",
                  "waived"
                ]
              },
              "cardinality": {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "enum": [
                      "exact",
                      "at_least",
                      "dynamic"
                    ]
                  },
                  "target": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "mode",
                  "target"
                ],
                "additionalProperties": true
              },
              "predicate": {
                "type": "object",
                "additionalProperties": {}
              },
              "evaluator": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "evaluator_version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "required": [
              "key",
              "title",
              "description",
              "kind",
              "policy",
              "cardinality",
              "predicate",
              "evaluator",
              "evaluator_version"
            ],
            "additionalProperties": true
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "const": "depends_on"
              }
            },
            "required": [
              "from",
              "to",
              "kind"
            ],
            "additionalProperties": true
          }
        },
        "initial_memberships": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "input_node_key": {
                "type": "string",
                "minLength": 1
              },
              "resource_item_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "required": [
              "input_node_key",
              "resource_item_ids"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [
        "title",
        "description",
        "entities",
        "nodes",
        "edges",
        "initial_memberships"
      ],
      "additionalProperties": true
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "node_key": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string",
            "minLength": 1
          },
          "verifier_id": {
            "type": "string",
            "enum": [
              "ctx.github-merge-verifier",
              "ctx.work-run-artifact",
              "ctx.manual-attestation",
              "ctx.declarative",
              "ctx.input-membership"
            ]
          },
          "verifier_version": {
            "type": "string",
            "minLength": 1
          },
          "verifier_label": {
            "type": "string",
            "enum": [
              "GITHUB VERIFIES",
              "HARNESS RECEIPT",
              "HARNESS + VERIFIED",
              "YOU ATTEST",
              "CTX JOINS",
              "EXACT INPUTS"
            ]
          },
          "repository": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "key",
          "node_key",
          "title",
          "detail",
          "verifier_id",
          "verifier_version",
          "verifier_label",
          "repository"
        ],
        "additionalProperties": true
      }
    },
    "extra_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "ctx.deployment-release-verifier",
              "ctx.browser-smoke-verifier"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "selected": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "version",
          "label",
          "selected"
        ],
        "additionalProperties": true
      }
    },
    "obligations": {
      "type": "object",
      "properties": {
        "repositories": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$"
          }
        },
        "join_requested": {
          "type": "boolean"
        },
        "parallel_requested": {
          "type": "boolean"
        }
      },
      "required": [
        "repositories",
        "join_requested",
        "parallel_requested"
      ],
      "additionalProperties": true
    },
    "graph_lint": {
      "type": "object",
      "properties": {
        "contract": {
          "type": "string",
          "const": "ctx.work-graph-lint.v1"
        },
        "valid": {
          "type": "boolean"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "severity": {
                "type": "string",
                "enum": [
                  "error",
                  "warning"
                ]
              },
              "code": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    }
                  ]
                }
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "severity",
              "code",
              "path",
              "message"
            ],
            "additionalProperties": true
          }
        },
        "topology": {
          "type": "object",
          "properties": {
            "entry_node_keys": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "terminal_node_keys": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "execution_order": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "entry_node_keys",
            "terminal_node_keys",
            "execution_order"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "contract",
        "valid",
        "diagnostics",
        "topology"
      ],
      "additionalProperties": true
    },
    "launch_ready": {
      "type": "boolean"
    },
    "generated_by": {
      "type": "string",
      "enum": [
        "deterministic",
        "model",
        "merged"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "ir": {
      "type": "object",
      "properties": {
        "contract": {
          "type": "string",
          "const": "ctx.work-obligation-ir.v1"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 90
        },
        "repositories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$"
              },
              "role": {
                "type": "string",
                "enum": [
                  "deployable",
                  "library",
                  "unknown"
                ]
              },
              "provenance": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "start": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "start",
                    "end",
                    "text"
                  ],
                  "additionalProperties": true
                },
                "minItems": 1
              }
            },
            "required": [
              "id",
              "role",
              "provenance"
            ],
            "additionalProperties": true
          },
          "maxItems": 12
        },
        "deliverables": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,40}$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "pull_request",
                  "commit",
                  "document",
                  "artifact",
                  "deployment",
                  "message"
                ]
              },
              "repository": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "provenance": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "start": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "start",
                    "end",
                    "text"
                  ],
                  "additionalProperties": true
                },
                "minItems": 1
              }
            },
            "required": [
              "key",
              "kind",
              "repository",
              "summary",
              "provenance"
            ],
            "additionalProperties": true
          },
          "maxItems": 24
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "deployment_release",
                  "browser_smoke",
                  "github_merge",
                  "owner_attestation",
                  "connector"
                ]
              },
              "target": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "provenance": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "start": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "start",
                    "end",
                    "text"
                  ],
                  "additionalProperties": true
                },
                "minItems": 1
              }
            },
            "required": [
              "kind",
              "target",
              "provenance"
            ],
            "additionalProperties": true
          },
          "maxItems": 24
        },
        "ordering": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "before": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,40}$"
              },
              "after": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,40}$"
                },
                "minItems": 1,
                "maxItems": 24
              }
            },
            "required": [
              "before",
              "after"
            ],
            "additionalProperties": true
          },
          "maxItems": 24
        },
        "join_requested": {
          "type": "boolean"
        },
        "parallel_requested": {
          "type": "boolean"
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "provenance": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "start": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "start",
                    "end",
                    "text"
                  ],
                  "additionalProperties": true
                },
                "minItems": 1
              }
            },
            "required": [
              "text",
              "provenance"
            ],
            "additionalProperties": true
          },
          "maxItems": 24
        },
        "source": {
          "type": "string",
          "enum": [
            "deterministic",
            "model",
            "merged"
          ]
        }
      },
      "required": [
        "contract",
        "title",
        "repositories",
        "deliverables",
        "checks",
        "ordering",
        "join_requested",
        "parallel_requested",
        "questions",
        "source"
      ],
      "additionalProperties": true
    },
    "template": {
      "type": "string",
      "enum": [
        "single_repo_delivery",
        "multi_repo_join",
        "report_only",
        "research_plan_handoff",
        "merge_gate",
        "owner_checklist"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "obligation_keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "spans": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 0
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "start",
                "end",
                "text"
              ],
              "additionalProperties": true
            }
          }
        },
        "required": [
          "obligation_keys",
          "spans"
        ],
        "additionalProperties": true
      }
    },
    "fallback_reason": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "model_timeout",
            "model_invalid",
            "model_unconfigured",
            "coverage_failed"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "fallback_detail": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 400
        },
        {
          "type": "null"
        }
      ]
    },
    "model_latency_ms": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "draft_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "final",
        "improving"
      ]
    }
  },
  "required": [
    "contract",
    "schema_version",
    "registry_version",
    "prompt",
    "outcome",
    "steps",
    "extra_receipts",
    "obligations",
    "graph_lint",
    "launch_ready",
    "generated_by",
    "generated_at",
    "ir",
    "template",
    "provenance",
    "fallback_reason",
    "model_latency_ms",
    "draft_id",
    "status"
  ],
  "additionalProperties": true
}
