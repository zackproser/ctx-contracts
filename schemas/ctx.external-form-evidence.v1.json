{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zackproser/ctx-contracts/schemas/ctx.external-form-evidence.v1.json",
  "title": "ctx.external-form-evidence.v1",
  "type": "object",
  "properties": {
    "contract": {
      "type": "string",
      "const": "ctx.external-form-evidence.v1"
    },
    "operation_id": {
      "type": "string",
      "format": "uuid"
    },
    "packet_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "identity_text": {
      "type": "string",
      "maxLength": 4000
    },
    "confirmation_text": {
      "type": "string",
      "maxLength": 4000
    },
    "values": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "maxLength": 8000
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4000
      },
      "maxItems": 50
    },
    "readback_context": {
      "type": "string",
      "const": "fresh"
    },
    "availability_readback": {
      "type": "object",
      "properties": {
        "advisor_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "starts_at": {
                "type": "string",
                "format": "date-time",
                "maxLength": 32
              },
              "ends_at": {
                "type": "string",
                "format": "date-time",
                "maxLength": 32
              }
            },
            "required": [
              "starts_at",
              "ends_at"
            ],
            "additionalProperties": false
          },
          "maxItems": 1000
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "status": {
          "type": "number",
          "const": 200
        }
      },
      "required": [
        "advisor_name",
        "timezone",
        "slots",
        "observed_at",
        "url",
        "status"
      ],
      "additionalProperties": false
    },
    "phase": {
      "type": "string",
      "enum": [
        "inspected",
        "submitted",
        "reconciled",
        "uncertain",
        "blocked"
      ]
    }
  },
  "required": [
    "contract",
    "operation_id",
    "packet_digest",
    "plan_digest",
    "observed_at",
    "url",
    "identity_text",
    "confirmation_text",
    "values",
    "errors",
    "phase"
  ],
  "additionalProperties": false
}
