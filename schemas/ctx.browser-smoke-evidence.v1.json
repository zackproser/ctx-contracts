{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zackproser/ctx-contracts/schemas/ctx.browser-smoke-evidence.v1.json",
  "title": "ctx.browser-smoke-evidence.v1",
  "type": "object",
  "properties": {
    "contract": {
      "type": "string",
      "const": "ctx.browser-smoke-evidence.v1"
    },
    "base_url": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048
    },
    "fixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "width": {
            "type": "integer",
            "minimum": 240,
            "maximum": 7680
          },
          "height": {
            "type": "integer",
            "minimum": 320,
            "maximum": 7680
          },
          "assertions_passed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "overflow": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "width",
          "height",
          "assertions_passed",
          "overflow"
        ],
        "additionalProperties": true
      },
      "minItems": 1,
      "maxItems": 40
    },
    "console_errors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "maxItems": 50
    },
    "page_errors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "maxItems": 50
    },
    "failure": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "contract",
    "base_url",
    "fixtures",
    "console_errors",
    "page_errors"
  ],
  "additionalProperties": true
}
