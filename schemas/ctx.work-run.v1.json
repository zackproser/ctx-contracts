{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zackproser/ctx-contracts/schemas/ctx.work-run.v1.json",
  "title": "ctx.work-run.v1",
  "type": "object",
  "properties": {
    "contract": {
      "type": "string",
      "const": "ctx.work-run.v1"
    },
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "task_item_id": {
      "type": "string",
      "format": "uuid"
    },
    "node_item_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "needs_input",
        "failed",
        "delivered",
        "verified"
      ]
    },
    "replayed": {
      "type": "boolean"
    }
  },
  "required": [
    "contract",
    "job_id",
    "task_item_id",
    "node_item_id",
    "state",
    "replayed"
  ],
  "additionalProperties": true
}
