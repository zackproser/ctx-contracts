{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zackproser/ctx-contracts/schemas/ctx.work-graph-lint.v1.json",
  "title": "ctx.work-graph-lint.v1",
  "type": "object",
  "properties": {
    "contract": {
      "type": "string",
      "const": "ctx.work-graph-lint.v1"
    },
    "valid": {
      "type": "boolean"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "warning"
            ]
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            }
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "severity",
          "code",
          "path",
          "message"
        ],
        "additionalProperties": true
      }
    },
    "topology": {
      "type": "object",
      "properties": {
        "entry_node_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "terminal_node_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "execution_order": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "entry_node_keys",
        "terminal_node_keys",
        "execution_order"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "contract",
    "valid",
    "diagnostics",
    "topology"
  ],
  "additionalProperties": true
}
