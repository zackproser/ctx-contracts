{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zackproser/ctx-contracts/schemas/ctx.work-node-instructions.v1.json",
  "title": "ctx.work-node-instructions.v1",
  "type": "object",
  "properties": {
    "contract": {
      "type": "string",
      "const": "ctx.work-node-instructions.v1"
    },
    "custody": {
      "type": "object",
      "properties": {
        "task_item_id": {
          "type": "string",
          "format": "uuid"
        },
        "graph_revision": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "graph_shape_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "node_item_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "node_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "node_instructions": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "task_item_id",
        "graph_revision",
        "graph_shape_hash",
        "node_item_id",
        "node_key",
        "node_instructions"
      ],
      "additionalProperties": true
    },
    "execution": {
      "type": "object",
      "properties": {
        "executable": {
          "type": "boolean"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "executable",
        "code",
        "reason"
      ],
      "additionalProperties": true
    },
    "mcp_control": {
      "type": "object",
      "properties": {
        "claim": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "client_id": {
                  "type": "string",
                  "minLength": 1
                },
                "harness": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "session_ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "attempt": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                "lease_expires_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "deadline_at": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "client_id",
                "harness",
                "session_ref",
                "attempt",
                "lease_expires_at",
                "deadline_at"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "graph_generation": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^[0-9]+$"
        },
        "steering": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "event_id": {
                "type": "string",
                "format": "uuid"
              },
              "sequence_no": {
                "type": "integer",
                "minimum": 0
              },
              "message": {
                "type": "string",
                "maxLength": 8192
              }
            },
            "required": [
              "event_id",
              "sequence_no",
              "message"
            ],
            "additionalProperties": false
          },
          "maxItems": 50
        },
        "steering_after": {
          "type": "integer",
          "minimum": 0
        },
        "has_more": {
          "type": "boolean"
        },
        "acknowledged_after": {
          "type": "integer",
          "minimum": 0
        },
        "may_checkpoint": {
          "type": "boolean"
        }
      },
      "required": [
        "claim",
        "graph_generation",
        "steering",
        "steering_after",
        "has_more",
        "acknowledged_after",
        "may_checkpoint"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract",
    "custody",
    "execution"
  ],
  "additionalProperties": true
}
